{
  "name": "@cross-code/nx-buck2",
  "version": "0.1.0",
  "private": true,
  "description": "Nx plugin for Buck2 — cross-compilation native builds with debug/release profiles, size optimization, and symbol preservation.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "nx": {
    "name": "nx-buck2",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "packages/nx-buck2/dist",
          "main": "packages/nx-buck2/src/index.ts",
          "tsConfig": "packages/nx-buck2/tsconfig.lib.json",
          "rootDir": "packages/nx-buck2/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/nx-buck2/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/nx-buck2/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": ">=21.0.0",
    "zx": "^8.8.5"
  },
  "files": ["dist", "!**/*.tsbuildinfo", "generators.json", "executors.json"],
  "scripts": {
    "test": "vitest run"
  }
}
