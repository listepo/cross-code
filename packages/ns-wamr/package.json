{
  "name": "@cross-code/ns-wamr",
  "version": "0.1.0",
  "description": "NativeScript plugin that runs WebAssembly modules with the WAMR (WebAssembly Micro Runtime) interpreter/JIT \u2014 Swift Package (C interop) on iOS, Kotlin + Rust JNI (cargo-ndk) on Android.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cross-code/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./polyfill": {
      "@cross-code/source": "./src/polyfill.ts",
      "types": "./dist/polyfill.d.ts",
      "import": "./dist/polyfill.js",
      "default": "./dist/polyfill.js"
    }
  },
  "files": [
    "dist",
    "src",
    "platforms/ios/NSCWamr/Package.swift",
    "platforms/ios/NSCWamr/Sources",
    "platforms/android/include.gradle",
    "platforms/android/nativescript-wamr.aar",
    "nativescript.config.ts",
    "test-support",
    "!**/*.tsbuildinfo",
    "platforms/ios/NSCWamr.xcframework",
    "platforms/ios/NSCWamr.xcframework.dSYMs"
  ],
  "nx": {
    "name": "ns-wamr",
    "targets": {
      "sync.vendors": {
        "executor": "nx:run-script",
        "options": {
          "script": "sync.vendors"
        }
      },
      "download.wamr": {
        "executor": "nx:run-script",
        "options": {
          "script": "download.wamr"
        }
      },
      "bindings": {
        "executor": "nx:run-script",
        "options": {
          "script": "bindings"
        }
      },
      "test.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "test.ios"
        }
      },
      "lint.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.ios"
        }
      },
      "periphery.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "periphery.ios"
        }
      },
      "test.android": {
        "executor": "nx:run-script",
        "options": {
          "script": "test.android"
        }
      },
      "build.android": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "target": "//packages/ns-wamr:wamr-android-aar",
          "configuration": "release"
        },
        "configurations": {
          "release": {
            "configuration": "release",
            "target": "//packages/ns-wamr:wamr-android-aar"
          },
          "debug": {
            "configuration": "debug",
            "target": "//packages/ns-wamr:wamr-android-aar"
          }
        },
        "defaultConfiguration": "release"
      },
      "lint.android": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.android"
        }
      },
      "lint.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.rust"
        }
      },
      "fmt.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "fmt.rust"
        }
      },
      "format.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "format.rust"
        }
      },
      "fixtures": {
        "executor": "nx:run-script",
        "options": {
          "script": "fixtures"
        }
      },
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "coverage.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage.ios"
        }
      },
      "coverage.android": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage.android"
        }
      },
      "buck2-build": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "target": "//packages/ns-wamr:all",
          "configuration": "release"
        },
        "configurations": {
          "release": {
            "configuration": "release",
            "target": "//packages/ns-wamr:all"
          },
          "debug": {
            "configuration": "debug",
            "target": "//packages/ns-wamr:all"
          }
        },
        "defaultConfiguration": "release"
      },
      "buck2-test": {
        "executor": "@cross-code/nx-buck2:test",
        "options": {
          "configuration": "debug"
        }
      },
      "build.xcframework": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "target": "//packages/ns-wamr:ns-wamr-xcframework",
          "configuration": "release"
        },
        "configurations": {
          "release": {
            "configuration": "release",
            "target": "//packages/ns-wamr:ns-wamr-xcframework"
          },
          "debug": {
            "configuration": "debug",
            "target": "//packages/ns-wamr:ns-wamr-xcframework"
          }
        },
        "defaultConfiguration": "release"
      }
    }
  },
  "scripts": {
    "download.wamr": "node tools/download-wamr.mjs",
    "bindings": "cd src/vendors/wamr-rust && WAMR_BINDGEN_COMMIT=1 cargo build",
    "fixtures": "node tools/gen-fixtures.mjs && node tools/sync-wamr.mjs",
    "sync.vendors": "node tools/sync-wamr.mjs",
    "test.ios": "cd platforms/ios/NSCWamr && swift test --disable-sandbox",
    "lint.ios": "swiftlint lint --config ../../.swiftlint.yml platforms/ios/NSCWamr/Sources platforms/ios/NSCWamr/Tests",
    "periphery.ios": "cd platforms/ios/NSCWamr && periphery scan --config $(git rev-parse --show-toplevel)/.periphery.yml --disable-update-check",
    "test.android": "cd platforms/android/wamr-android && ./gradlew :hosttest:test",
    "build.android": "pnpm exec nx run ns-wamr:build.android",
    "lint.android": "cd platforms/android/wamr-android && ./gradlew detekt ktlintCheck",
    "lint.rust": "cd src/vendors/wamr-rust && cargo clippy --all-features --lib --tests -- -D warnings",
    "fmt.rust": "cd src/vendors/wamr-rust && find . -name '*.rs' -not -path './target/*' -not -path './.git/*' -not -name 'uniffi-bindgen.rs' -print0 | xargs -0 rustfmt --check --edition 2021",
    "format.rust": "cd src/vendors/wamr-rust && find . -name '*.rs' -not -path './target/*' -not -path './.git/*' -not -name 'uniffi-bindgen.rs' -print0 | xargs -0 rustfmt --edition 2021",
    "typings.ios": "nx run ns-wasm-test:typings.ios",
    "typings.android": "nx run ns-wasm-test:typings.android",
    "coverage": "vitest run --coverage",
    "coverage.ios": "cd platforms/ios/NSCWamr && swift test --enable-code-coverage && xcrun llvm-cov report .build/debug/NSCWamrPackageTests.xctest/Contents/MacOS/NSCWamrPackageTests -instr-profile .build/debug/codecov/default.profdata -ignore-filename-regex='Sources/CWamr|/usr/'",
    "coverage.android": "cd platforms/android/wamr-android && ./gradlew :hosttest:jacocoTestReport",
    "build.xcframework": "pnpm exec nx run ns-wamr:build.xcframework"
  },
  "dependencies": {
    "@cross-code/ns-wasm-core": "workspace:*"
  },
  "nativescript": {
    "platforms": {
      "ios": "8.6.0",
      "android": "8.6.0"
    }
  }
}
