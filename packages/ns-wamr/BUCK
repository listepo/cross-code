# Buck2 build definitions for @cross-code/ns-wamr
#
# Each genrule wraps the existing toolchain (Cargo / swift build).
# Debug/release is controlled by $BUCK2_MODIFIER injected by nx-buck2 executor.
# --mode {debug,release} sets .buckconfig [build_mode.*] compiler flags for
# native cxx_library targets; for genrules we read the env var instead.
#
# Target naming convention:
#   :<name>-<platform>[-<arch>]  e.g. :wamr-c-ios-arm64

# ── WAMR C library (host, via Cargo workspace) ─────────────────────

genrule(
    name = "wamr-c",
    srcs = glob([
        "src/vendors/wamr/core/**/*.c",
        "src/vendors/wamr/core/**/*.h",
        # cargo needs every workspace member's manifest to resolve the
        # workspace, even to build just wamr-sys (see wamr-ffi/wamr-jni).
        "src/vendors/wamr-rust/**/*.rs",
        "src/vendors/wamr-rust/**/*.toml",
        "src/vendors/wamr-rust/**/*.h",
        "src/vendors/wamr-rust/**/*.udl",
        "src/vendors/wamr-rust/Cargo.lock",
    ]),
    out = "libwamr_sys.a",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; DIR=\"release\"; if [ \"$MODE\" = debug ]; then PROFILE=\"dev\"; DIR=\"debug\"; fi; cd $SRCDIR/src/vendors/wamr-rust && cargo build -p wamr-sys --profile $PROFILE 2>&1 && cp target/$DIR/libwamr_sys.a $OUT",
    visibility = ["PUBLIC"],
)

# ── Rust JNI library (Android, via cargo-ndk) ─────────────────────

genrule(
    name = "wamr-android-aar",
    srcs = glob([
        "platforms/android/wamr-android/**/*.kt",
        "platforms/android/wamr-android/**/*.kts",
        "platforms/android/wamr-android/**/gradle/**",
        "platforms/android/wamr-android/gradlew",
        "platforms/android/wamr-android/**/*.pro",
        "src/vendors/wamr-rust/**/*.rs",
        "src/vendors/wamr-rust/**/*.toml",
        "src/vendors/wamr-rust/**/*.h",
        "src/vendors/wamr-rust/**/*.udl",
        "src/vendors/wamr-rust/Cargo.lock",
        "src/vendors/wamr/**/*.c",
        "src/vendors/wamr/**/*.h",
        # gradle's buildNative task declares this as an input dir (shimSources)
        "src/native/shim/**/*.c",
        "src/native/shim/**/*.h",
    ]),
    out = "nativescript-wamr.aar",
    # deployAar writes one level up from wamr-android/ (see
    # library/build.gradle.kts). Capture $OUT before cd'ing — $OUT is
    # relative to the srcs root. That landing pad is the buck2 *sandbox*
    # (srcs are mirrored under .buck-out/), so install-nativescript-aar.sh
    # then copies $OUT into the real packages/ns-wamr/platforms/android/
    # tree NativeScript scans — same pattern as build-xcframework.sh.
    # (Gradle's :library/:hosttest build/ dirs are redirected outside
    # platforms/android/ in build.gradle.kts's subprojects{} block.)
    cmd = "OUT_ABS=\"$PWD/$OUT\"; ROOT=\"`git rev-parse --show-toplevel`\"; cd $SRCDIR/platforms/android/wamr-android && bash \"$ROOT/tools/gradlew-retry.sh\" :library:deployAar && cp ../nativescript-wamr.aar \"$OUT_ABS\" && bash \"$ROOT/tools/install-nativescript-aar.sh\" ns-wamr nativescript-wamr.aar \"$OUT_ABS\"",
    visibility = ["PUBLIC"],
)

genrule(
    name = "wamr-jni-android",
    srcs = glob([
        "src/vendors/wamr-rust/**/*.rs",
        "src/vendors/wamr-rust/**/*.toml",
        "src/vendors/wamr-rust/Cargo.lock",
        "src/vendors/wamr/core/**/*.c",
        "src/vendors/wamr/core/**/*.h",
    ]),
    out = "libwamr_jni.so",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; DIR=\"release\"; if [ \"$MODE\" = debug ]; then PROFILE=\"dev\"; DIR=\"debug\"; fi; cd $SRCDIR/src/vendors/wamr-rust && cargo ndk -t arm64-v8a build -p wamr-jni --profile $PROFILE 2>&1 && find target -name 'libwamr_jni.so' | head -1 | xargs -I{} cp {} $OUT && echo 'JNI .so built'",
    visibility = ["PUBLIC"],
)

# ── Swift @objc wrapper (macOS host, for hosttest) ─────────────────

genrule(
    name = "nsc-wamr-swift-host",
    srcs = glob([
        "platforms/ios/NSCWamr/Sources/**/*.swift",
        "platforms/ios/NSCWamr/Package.swift",
        "platforms/ios/NSCWamr/Sources/**/include/**/*.h",
    ]),
    out = "NSCWamr.dylib",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; CONF=\"release\"; [ \"$MODE\" = debug ] && CONF=\"debug\"; cd $SRCDIR/platforms/ios/NSCWamr && swift build --disable-sandbox --configuration $CONF 2>&1 && cp .build/$CONF/libNSCWamr.dylib $OUT",
    visibility = ["PUBLIC"],
)

# ── iOS xcframework (device + simulator) ───────────────────────────

genrule(
    name = "ns-wamr-xcframework",
    srcs = glob([
        "platforms/ios/**/*.swift",
        "platforms/ios/**/*.h",
        "platforms/ios/**/Package.swift",
    ]),
    out = "NSCWamr.xcframework.stamp",
    # $SRCDIR only mirrors this package's own globbed srcs, so the shared
    # tools/build-xcframework.sh (one level up, at the repo root) can't be
    # referenced through it. Resolve the real repo root via git instead —
    # $SRCDIR/buck-out is itself inside the checkout, so this works both
    # under buck2's sandboxed srcs dir and for a human running it directly.
    cmd = "bash \"`git rev-parse --show-toplevel`/tools/build-xcframework.sh\" NSCWamr 2>&1 && touch $OUT",
    visibility = ["PUBLIC"],
)

# ── Kotlin hosttest ────────────────────────────────────────────────

genrule(
    name = "hosttest",
    srcs = glob([
        "platforms/android/wamr-android/**/*.kt",
        "platforms/android/wamr-android/**/*.kts",
    ]),
    out = "hosttest-report.xml",
    cmd = "cd $SRCDIR/platforms/android/wamr-android && bash \"`git rev-parse --show-toplevel`/tools/gradlew-retry.sh\" :hosttest:test 2>&1 && touch $OUT",
    visibility = ["PUBLIC"],
)

# ── All targets (aggregate) ────────────────────────────────────────

genrule(
    name = "all",
    out = "all.stamp",
    cmd = "echo 'ns-wamr: all targets built' && touch $OUT",
    srcs = [
        ":wamr-c",
        ":wamr-android-aar",
        ":ns-wamr-xcframework",
    ],
    visibility = ["PUBLIC"],
)
