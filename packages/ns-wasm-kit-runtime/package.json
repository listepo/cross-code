{
  "name": "@cross-code/ns-wasm-kit-runtime",
  "version": "0.1.0",
  "description": "NativeScript plugin that runs WebAssembly modules with the WasmKit interpreter (https://github.com/swiftwasm/WasmKit) \u2014 Swift Package on iOS, TypeScript adapter with platform-native classes.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cross-code/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./polyfill": {
      "@cross-code/source": "./src/polyfill.ts",
      "types": "./dist/polyfill.d.ts",
      "import": "./dist/polyfill.js",
      "default": "./dist/polyfill.js"
    }
  },
  "files": [
    "dist",
    "nativescript.config.ts",
    "platforms/ios/NSWasmKit/Package.swift",
    "platforms/ios/NSWasmKit/Sources",
    "platforms/android/include.gradle",
    "!**/*.tsbuildinfo"
  ],
  "nativescript": {
    "platforms": {
      "ios": "8.6.0",
      "android": "8.6.0"
    }
  },
  "scripts": {
    "test.ios": "cd platforms/ios/NSWasmKit && swift test --disable-sandbox",
    "lint.ios": "swiftlint lint --config ../../.swiftlint.yml platforms/ios/NSWasmKit/Sources platforms/ios/NSWasmKit/Tests",
    "periphery.ios": "cd platforms/ios/NSWasmKit && periphery scan --config $(git rev-parse --show-toplevel)/.periphery.yml --disable-update-check",
    "coverage": "vitest run --coverage",
    "build.xcframework": "pnpm exec nx run ns-wasm-kit-runtime:build.xcframework"
  },
  "nx": {
    "name": "ns-wasm-kit-runtime",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "lint.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.ios"
        }
      },
      "periphery.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "periphery.ios"
        }
      },
      "buck2-build": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "target": "//packages/ns-wasm-kit-runtime:all",
          "configuration": "release"
        },
        "configurations": {
          "release": {
            "configuration": "release",
            "target": "//packages/ns-wasm-kit-runtime:all"
          },
          "debug": {
            "configuration": "debug",
            "target": "//packages/ns-wasm-kit-runtime:all"
          }
        },
        "defaultConfiguration": "release"
      },
      "build.xcframework": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "target": "//packages/ns-wasm-kit-runtime:ns-wasmkit-xcframework-release",
          "configuration": "release"
        },
        "configurations": {
          "release": {
            "configuration": "release",
            "target": "//packages/ns-wasm-kit-runtime:ns-wasmkit-xcframework-release"
          },
          "debug": {
            "configuration": "debug",
            "target": "//packages/ns-wasm-kit-runtime:ns-wasmkit-xcframework-debug"
          }
        },
        "defaultConfiguration": "release"
      }
    }
  },
  "dependencies": {
    "@cross-code/ns-wasm-core": "workspace:*",
    "tslib": "^2.3.0"
  }
}
