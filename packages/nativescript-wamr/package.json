{
  "name": "@org/nativescript-wamr",
  "version": "0.1.0",
  "description": "NativeScript plugin that runs WebAssembly modules with the WAMR (WebAssembly Micro Runtime) interpreter/JIT — Swift Package (C interop) on iOS, Kotlin + JavaCPP-generated JNI bindings on Android.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "platforms",
    "nativescript.config.ts",
    "test-support"
  ],
  "nx": {
    "name": "nativescript-wamr",
    "targets": {
      "sync.vendors": {
        "executor": "nx:run-script",
        "options": { "script": "sync.vendors" }
      },
      "download.wamr": {
        "executor": "nx:run-script",
        "options": { "script": "download.wamr" }
      },
      "test.ios": {
        "executor": "nx:run-script",
        "options": { "script": "test.ios" }
      },
      "test.android": {
        "executor": "nx:run-script",
        "options": { "script": "test.android" }
      },
      "build.android": {
        "executor": "nx:run-script",
        "options": { "script": "build.android" }
      },
      "fixtures": {
        "executor": "nx:run-script",
        "options": { "script": "fixtures" }
      }
    }
  },
  "scripts": {
    "download.wamr": "node tools/download-wamr.mjs",
    "fixtures": "node tools/gen-fixtures.mjs && node tools/sync-wamr.mjs",
    "sync.vendors": "node tools/sync-wamr.mjs",
    "test.ios": "cd platforms/ios/NSCWamr && swift test --disable-sandbox",
    "test.android": "cd platforms/android/wamr-android && ./gradlew :hosttest:test",
    "build.android": "cd platforms/android/wamr-android && ./gradlew :library:deployAar"
  },
  "devDependencies": {
    "@nativescript/core": "^8.9.0"
  }
}
