{
    "name": "@cross-code/ns-rspack",
    "version": "0.0.1",
    "description": "rspack bundler for NativeScript apps — the @nativescript/webpack config, compiled by rspack.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "ns-rspack": "./dist/bin/index.js"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@cross-code/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!**/*.tsbuildinfo"
    ],
    "dependencies": {
        "@nativescript/webpack": "~5.0.38",
        "@rspack/core": "^2.1.9",
        "jiti": "^2.4.2",
        "rspack-chain": "^2.2.0",
        "tslib": "^2.3.0"
    }
}
