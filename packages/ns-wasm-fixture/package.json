{
  "name": "@cross-code/ns-wasm-fixture",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./src/test-types/pkg/test_types.d.ts",
      "import": "./src/test-types/pkg/test_types.js",
      "default": "./src/test-types/pkg/test_types.js"
    },
    "./types.wasm": "./src/test-types/pkg/test_types_bg.wasm",
    "./globals.wasm": "./src/test-types/pkg/globals.wasm"
  },
  "scripts": {
    "build.wasm": "wasm-pack build src/test-types --target bundler --out-dir pkg && rm -f src/test-types/pkg/.gitignore && cargo run --quiet --manifest-path src/test-types/Cargo.toml --bin gen_globals -- src/test-types/pkg",
    "test.wasm": "cargo test --manifest-path src/test-types/Cargo.toml",
    "lint.rust": "cargo clippy --manifest-path src/test-types/Cargo.toml --all-targets --all-features -- -D warnings",
    "fmt.rust": "cargo fmt --manifest-path src/test-types/Cargo.toml -- --check",
    "format.rust": "cargo fmt --manifest-path src/test-types/Cargo.toml",
    "coverage": "bash tools/coverage.sh"
  },
  "nx": {
    "name": "ns-wasm-fixture",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "lint.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.rust"
        }
      },
      "fmt.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "fmt.rust"
        }
      },
      "format.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "format.rust"
        }
      }
    }
  },
  "dependencies": {}
}
