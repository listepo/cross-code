{
  "name": "@cross-code/test-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./pkg/test_types.d.ts",
      "import": "./pkg/test_types.js",
      "default": "./pkg/test_types.js"
    },
    "./types.wasm": {
      "types": "./types.wasm.d.ts",
      "default": "./pkg/test_types_bg.wasm"
    },
    "./globals.wasm": "./pkg/globals.wasm"
  },
  "scripts": {
    "build.wasm": "wasm-pack build . --target bundler --out-dir pkg && rm -f pkg/.gitignore && cargo run --quiet --bin gen_globals -- pkg",
    "test.wasm": "cargo test",
    "lint.rust": "cargo clippy --all-targets --all-features -- -D warnings",
    "fmt.rust": "cargo fmt -- --check",
    "format.rust": "cargo fmt",
    "coverage": "bash tools/coverage.sh"
  },
  "nx": {
    "name": "test-types",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "lint.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.rust"
        }
      },
      "fmt.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "fmt.rust"
        }
      },
      "format.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "format.rust"
        }
      }
    }
  },
  "dependencies": {}
}
