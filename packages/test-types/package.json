{
  "name": "@cross-code/test-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./pkg/test_types.d.ts",
      "import": "./pkg/test_types.js",
      "default": "./pkg/test_types.js"
    },
    "./types.wasm": {
      "types": "./types.wasm.d.ts",
      "default": "./pkg/test_types_bg.wasm"
    },
    "./globals.wasm": "./pkg/globals.wasm"
  },
  "scripts": {
    "build.wasm": "wasm-pack build . --target bundler --out-dir pkg && rm -f pkg/.gitignore && cargo run --quiet --bin gen_globals -- pkg && pnpm run gen.types",
    "gen.types": "ns-rspack types pkg/test_types_bg.wasm --out types.wasm.d.ts --functions-from ./pkg/test_types_bg.wasm.js",
    "test.wasm": "cargo test",
    "lint.rust": "cargo clippy --all-targets --all-features -- -D warnings",
    "fmt.rust": "cargo fmt -- --check",
    "format.rust": "cargo fmt",
    "coverage": "bash tools/coverage.sh"
  },
  "nx": {
    "name": "test-types",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "gen.types": {
        "executor": "nx:run-script",
        "options": {
          "script": "gen.types"
        },
        "dependsOn": ["@cross-code/ns-rspack:build"]
      },
      "build.wasm": {
        "executor": "nx:run-script",
        "options": {
          "script": "build.wasm"
        },
        "dependsOn": ["@cross-code/ns-rspack:build"]
      },
      "lint.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.rust"
        }
      },
      "fmt.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "fmt.rust"
        }
      },
      "format.rust": {
        "executor": "nx:run-script",
        "options": {
          "script": "format.rust"
        }
      }
    }
  },
  "devDependencies": {
    "@cross-code/ns-rspack": "workspace:*"
  },
  "dependencies": {
    "@cross-code/ns-wasm-core": "workspace:*"
  }
}
