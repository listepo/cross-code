{
  "name": "@cross-code/vitest-nativescript",
  "version": "0.0.1",
  "description": "Run Vitest unit tests inside isolated NativeScript runtimes on Android and iOS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cross-code/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "@cross-code/source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./runtime": {
      "@cross-code/source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/shim": {
      "@cross-code/source": "./src/runtime/shim.ts",
      "types": "./dist/runtime/shim.d.ts",
      "import": "./dist/runtime/shim.js",
      "default": "./dist/runtime/shim.js"
    },
    "./webpack": {
      "require": "./webpack.cjs",
      "default": "./webpack.cjs"
    }
  },
  "files": [
    "dist",
    "webpack.cjs",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "vitest",
    "nativescript",
    "unit-testing",
    "android",
    "ios"
  ],
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "name": "vitest-nativescript"
  },
  "dependencies": {
    "@vitest/expect": "~4.1.10",
    "birpc": "^2.9.0",
    "chai": "^6.2.2",
    "flatted": "^3.4.4",
    "tslib": "^2.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/runner": "~4.1.10",
    "vitest": "~4.1.10"
  },
  "peerDependencies": {
    "@vitest/runner": "~4.1.10",
    "vitest": "~4.1.10"
  }
}
