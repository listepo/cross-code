# Buck2 build definitions for @cross-code/ns-wry
#
# buck2 genrule wrapper cd's to buck-out/.../srcs before running the command.
# Source files are mirrored there at matching paths. Use relative paths from
# srcs. Do NOT use $SRCDIR (it points to srcs after the wrapper cd).

genrule(
    name = "wry-rust-host",
    srcs = glob([
        "src/vendors/wry-rust/**/*.rs",
        "src/vendors/wry-rust/**/*.toml",
        "src/vendors/wry-rust/**/*.udl",
    ]),
    out = "wry-rust-host.stamp",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; [ \"$MODE\" = debug ] && PROFILE=\"debug\"; cargo build --manifest-path src/vendors/wry-rust/Cargo.toml -p wry-sys --profile $PROFILE --target-dir src/vendors/wry-rust/target 2>&1 && echo 'wry-rust built ($MODE)' && touch $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "wry-jni-android",
    srcs = glob([
        "src/vendors/wry-rust/**/*.rs",
        "src/vendors/wry-rust/**/*.toml",
    ]),
    out = "libwry_jni.so",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; [ \"$MODE\" = debug ] && PROFILE=\"debug\"; cargo ndk -t arm64-v8a build --manifest-path src/vendors/wry-rust/Cargo.toml -p wry-jni --profile $PROFILE --target-dir src/vendors/wry-rust/target 2>&1 && find src/vendors/wry-rust/target -name 'libwry_jni.so' | head -1 | xargs -I{} cp {} $OUT && echo 'JNI .so built'",
    visibility = ["PUBLIC"],
)

genrule(
    name = "nsc-wry-swift-host",
    srcs = glob([
        "platforms/ios/NSCWry/Sources/**/*.swift",
        "platforms/ios/NSCWry/Tests/**/*.swift",
        "platforms/ios/NSCWry/Package.swift",
    ]),
    out = "nsc-wry-swift-host.stamp",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; CONF=\"release\"; [ \"$MODE\" = debug ] && CONF=\"debug\"; swift build --disable-sandbox --configuration $CONF --package-path platforms/ios/NSCWry --target NSCWry 2>&1 && echo 'NSCWry Swift built ($MODE)' && touch $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "ns-wry-xcframework",
    srcs = glob([
        "platforms/ios/**/*.swift",
        "platforms/ios/**/*.h",
        "platforms/ios/**/Package.swift",
        "tools/build-xcframework.sh",
    ]),
    out = "NSCWry.xcframework.stamp",
    cmd = "bash tools/build-xcframework.sh 2>&1 && touch $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "all",
    srcs = [],
    out = "all.stamp",
    cmd = "echo 'ns-wry: all targets built' && touch $OUT",
    deps = [
        ":wry-rust-host",
        ":wry-jni-android",
        ":ns-wry-xcframework",
    ],
    visibility = ["PUBLIC"],
)
