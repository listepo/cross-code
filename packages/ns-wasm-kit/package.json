{
  "name": "@cross-code/ns-wasm-kit",
  "version": "0.1.0",
  "description": "Reusable WebAssembly runtime abstractions for NativeScript plugins — base Runtime/Module/Function classes, native adapter interfaces, and platform adapter helpers.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cross-code/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "name": "ns-wasm-kit",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      }
    }
  },
  "scripts": {
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cross-code/ns-wasm-core": "workspace:*"
  }
}
