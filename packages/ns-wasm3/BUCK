# Buck2 build definitions for @cross-code/ns-wasm3

genrule(
    name = "wasm3-c",
    srcs = glob([
        "src/vendors/wasm3/source/**/*.c",
        "src/vendors/wasm3/source/**/*.h",
        "src/vendors/wasm3-rust/wasm3-sys/**/*.rs",
        "src/vendors/wasm3-rust/wasm3-sys/Cargo.toml",
    ]),
    out = "libwasm3_sys.a",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; [ \"$MODE\" = debug ] && PROFILE=\"debug\"; cd $SRCDIR/src/vendors/wasm3-rust && cargo build -p wasm3-sys --profile $PROFILE 2>&1 && cp target/$PROFILE/libwasm3_sys.a $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "wasm3-android-aar",
    srcs = glob([
        "platforms/android/wasm3-android/**/*.kt",
        "platforms/android/wasm3-android/**/*.kts",
        "platforms/android/wasm3-android/**/gradle/**",
        "platforms/android/wasm3-android/gradlew",
        "src/vendors/wasm3-rust/**/*.rs",
        "src/vendors/wasm3-rust/**/*.toml",
        "src/vendors/wasm3/source/**/*.c",
        "src/vendors/wasm3/source/**/*.h",
    ]),
    out = "nativescript-wasm3.aar",
    cmd = "cd $SRCDIR/platforms/android/wasm3-android && ./gradlew :library:deployAar && cp $SRCDIR/platforms/android/nativescript-wasm3.aar $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "wasm3-jni-android",
    srcs = glob([
        "src/vendors/wasm3-rust/**/*.rs",
        "src/vendors/wasm3-rust/**/*.toml",
        "src/vendors/wasm3/source/**/*.c",
        "src/vendors/wasm3/source/**/*.h",
    ]),
    out = "libwasm3_jni.so",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; PROFILE=\"release\"; [ \"$MODE\" = debug ] && PROFILE=\"debug\"; cd $SRCDIR/src/vendors/wasm3-rust && cargo ndk -t arm64-v8a build -p wasm3-jni --profile $PROFILE 2>&1 && find target -name 'libwasm3_jni.so' | head -1 | xargs -I{} cp {} $OUT && echo 'JNI .so built'",
    visibility = ["PUBLIC"],
)

genrule(
    name = "nsc-wasm3-swift-host",
    srcs = glob([
        "platforms/ios/NSCWasm3/Sources/**/*.swift",
        "platforms/ios/NSCWasm3/Package.swift",
    ]),
    out = "NSCWasm3.dylib",
    cmd = "MODE=${BUCK2_MODIFIER:-release}; CONF=\"release\"; [ \"$MODE\" = debug ] && CONF=\"debug\"; cd $SRCDIR/platforms/ios/NSCWasm3 && swift build --disable-sandbox --configuration $CONF 2>&1 && cp .build/$CONF/libNSCWasm3.dylib $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "ns-wasm3-xcframework",
    srcs = glob([
        "platforms/ios/**/*.swift",
        "platforms/ios/**/*.h",
        "platforms/ios/**/Package.swift",
        "tools/build-xcframework.sh",
    ]),
    out = "NSCWasm3.xcframework.stamp",
    cmd = "bash $SRCDIR/tools/build-xcframework.sh 2>&1 && touch $OUT",
    visibility = ["PUBLIC"],
)

genrule(
    name = "all",
    srcs = [],
    out = "all.stamp",
    cmd = "echo 'ns-wasm3: all targets built' && touch $OUT",
    deps = [
        ":wasm3-c",
        ":wasm3-android-aar",
        ":ns-wasm3-xcframework",
    ],
    visibility = ["PUBLIC"],
)
