{
  "name": "@cross-code/ns-wasm3",
  "version": "0.1.0",
  "description": "NativeScript plugin that runs WebAssembly modules with the wasm3 interpreter \u2014 Swift Package (C interop) on iOS, Kotlin + Rust JNI (cargo-ndk) on Android.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cross-code/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "nativescript.config.ts",
    "platforms/ios/NSCWasm3/Package.swift",
    "platforms/ios/NSCWasm3/Sources",
    "platforms/android/include.gradle",
    "platforms/android/nativescript-wasm3.aar",
    "!**/*.tsbuildinfo",
    "platforms/ios/NSCWasm3.xcframework",
    "platforms/ios/NSCWasm3.xcframework.dSYMs"
  ],
  "nativescript": {
    "platforms": {
      "ios": "8.6.0",
      "android": "8.6.0"
    }
  },
  "scripts": {
    "fixtures": "node tools/gen-fixtures.mjs && node tools/sync-wasm3.mjs",
    "sync.vendors": "node tools/sync-wasm3.mjs",
    "test.ios": "cd platforms/ios/NSCWasm3 && swift test --disable-sandbox",
    "lint.ios": "swiftlint lint --config ../../.swiftlint.yml platforms/ios/NSCWasm3/Sources platforms/ios/NSCWasm3/Tests",
    "periphery.ios": "cd platforms/ios/NSCWasm3 && periphery scan --config $(git rev-parse --show-toplevel)/.periphery.yml --disable-update-check",
    "test.android": "cd platforms/android/wasm3-android && ./gradlew :hosttest:test",
    "build.android": "cd platforms/android/wasm3-android && ./gradlew :library:deployAar",
    "lint.android": "cd platforms/android/wasm3-android && ./gradlew detekt ktlintCheck",
    "coverage": "vitest run --coverage",
    "coverage.ios": "cd platforms/ios/NSCWasm3 && swift test --enable-code-coverage && xcrun llvm-cov report .build/debug/NSCWasm3PackageTests.xctest/Contents/MacOS/NSCWasm3PackageTests -instr-profile .build/debug/codecov/default.profdata -ignore-filename-regex='Sources/CWasm3|/usr/'",
    "coverage.android": "cd platforms/android/wasm3-android && ./gradlew :hosttest:jacocoTestReport",
    "build.xcframework": "bash tools/build-xcframework.sh"
  },
  "keywords": [
    "NativeScript",
    "WebAssembly",
    "wasm",
    "wasm3",
    "ios",
    "android"
  ],
  "nx": {
    "name": "ns-wasm3",
    "targets": {
      "coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage"
        }
      },
      "coverage.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage.ios"
        }
      },
      "coverage.android": {
        "executor": "nx:run-script",
        "options": {
          "script": "coverage.android"
        }
      },
      "lint.android": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.android"
        }
      },
      "lint.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint.ios"
        }
      },
      "periphery.ios": {
        "executor": "nx:run-script",
        "options": {
          "script": "periphery.ios"
        }
      },
      "buck2-build": {
        "executor": "@cross-code/nx-buck2:build",
        "options": {
          "configuration": "release"
        }
      }
    }
  },
  "dependencies": {
    "@cross-code/ns-wasm-core": "workspace:*",
    "@cross-code/ns-wasm-kit": "workspace:*",
    "tslib": "^2.3.0"
  }
}