# act configuration for local CI debugging
# See: https://nektosact.com/usage/index.html#configuration-file

# Apple Silicon needs explicit architecture
--container-architecture linux/amd64

# Slim image (~500 MB) — has Node, npm, Python, git.
# The Rust and Java steps will fail because cargo/javac are not installed;
# run those directly on the host instead:
#   cargo test --manifest-path packages/ns-wasm-fixture/src/test-types/Cargo.toml
#   cd packages/ns-wasm3/platforms/android/wasm3-android && ./gradlew :hosttest:test
#
# To run everything in act switch to the full image (~17 GB):
#   -P ubuntu-latest=ghcr.io/catthehacker/ubuntu:full-22.04
-P ubuntu-latest=catthehacker/ubuntu:act-latest
