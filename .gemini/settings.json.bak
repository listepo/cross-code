{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "nx",
        "mcp"
      ]
    },
    "code-review-graph": {
      "command": "/opt/homebrew/opt/python@3.14/bin/python3.14",
      "args": [
        "-m",
        "code_review_graph",
        "serve"
      ],
      "cwd": "/Users/listepo/GitHub/cross-code"
    }
  },
  "contextFileName": "AGENTS.md"
}
