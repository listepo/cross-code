{
  "name": "@cross-code/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "clean.cache": "node tools/clean.mjs",
    "clean.cache:all": "node tools/clean.mjs --all",
    "verify:lockfiles": "node tools/verify-nested-lockfiles.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@cross-code/nx-buck2": "workspace:*",
    "@cross-code/nx-ns-app": "workspace:*",
    "@nx/devkit": "^23.3.0",
    "@nx/js": "23.3.0",
    "@nx/plugin": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "~4.1.0",
    "agent-device": "^0.21.24",
    "jiti": "2.7.0",
    "nativescript": "^9.1.2",
    "nx": "23.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "skills": "^1.7.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "verdaccio": "^6.10.5",
    "vite": "^8.3.4",
    "vitest": "~4.1.0",
    "zx": "^8.8.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "dependencies": {}
}
