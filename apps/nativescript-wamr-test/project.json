{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "nativescript-wamr-test",
  "projectType": "application",
  "sourceRoot": "apps/nativescript-wamr-test/app",
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "{projectRoot}/app/**/*",
        "{projectRoot}/references.d.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.spec.json",
        "^production"
      ]
    },
    "test.ios": {
      "command": "ns test ios --emulator",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": false
    },
    "test.android": {
      "command": "ns test android --emulator",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
