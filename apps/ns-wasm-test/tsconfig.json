{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"],
      "@/*": ["app/*"]
    }
  },
  "include": ["app/**/*"],
  "files": ["./references.d.ts"],
  // Vitest specs and the test-only app/Worker entries are owned by
  // tsconfig.spec.json and are only bundled for env.vitestNativeScript.
  "exclude": [
    "node_modules",
    "platforms",
    "app/vitest-nativescript.ts",
    "app/vitest-nativescript.worker.ts",
    "app/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages/nativescript-wamr"
    },
    {
      "path": "../../packages/nativescript-wasm3"
    },
    {
      "path": "../../packages/nativescript-wasm-fixture"
    },
    {
      "path": "../../packages/vitest-nativescript"
    },
    {
      "path": "../../packages/vitest-nativescript-ui"
    }
  ]
}
