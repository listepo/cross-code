{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"],
      "@/*": ["app/*"]
    }
  },
  "include": ["app/**/*"],
  "files": ["./references.d.ts"],
  // Rstest specs and the test-only app/Worker entries are owned by
  // tsconfig.spec.json and are only bundled for env.rstestNativeScript.
  "exclude": [
    "node_modules",
    "platforms",
    "app/ns-rstest.ts",
    "app/ns-rstest.worker.ts",
    "app/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages/ns-rspack"
    },
    {
      "path": "../../packages/test-types"
    },
    {
      "path": "../../packages/ns-rstest"
    },
    {
      "path": "../../packages/ns-wasm-chicory"
    },
    {
      "path": "../../packages/ns-wasm-edge"
    },
    {
      "path": "../../packages/ns-endive"
    },
    {
      "path": "../../packages/ns-wasm-kit-runtime"
    },
    {
      "path": "../../packages/ns-wasm3"
    },
    {
      "path": "../../packages/ns-wamr"
    }
  ]
}
