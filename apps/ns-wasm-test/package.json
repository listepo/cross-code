{
  "name": "ns-wasm-test",
  "main": "app/app.ts",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "NativeScript test app for @cross-code/nativescript-wasm3 and @cross-code/nativescript-wamr — runs the shared WebAssembly fixture on-device with Vitest.",
  "scripts": {
    "test.ios": "vitest run --config vitest.ios.config.mts",
    "test.android": "vitest run --config vitest.android.config.mts",
    "test.ios:coverage": "vitest run --coverage --config vitest.ios.config.mts",
    "test.android:coverage": "vitest run --coverage --config vitest.android.config.mts"
  },
  "dependencies": {
    "@cross-code/nativescript-wamr": "file:../../packages/nativescript-wamr",
    "@cross-code/nativescript-wasm-fixture": "file:../../packages/nativescript-wasm-fixture",
    "@cross-code/nativescript-wasm3": "file:../../packages/nativescript-wasm3",
    "@cross-code/vitest-nativescript": "file:../../packages/vitest-nativescript",
    "@cross-code/vitest-nativescript-ui": "file:../../packages/vitest-nativescript-ui",
    "@nativescript/core": "~9.0.0",
    "@nativescript/theme": "^3.1.0",
    "@valor/nativescript-websockets": "2.0.3"
  },
  "devDependencies": {
    "@nativescript/android": "9.0.5",
    "@nativescript/ios": "9.0.3",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "~5.0.25",
    "@vitest/coverage-istanbul": "~4.1.10",
    "@vitest/runner": "~4.1.10",
    "postcss-loader": "8.2.1",
    "ts-loader": "9.6.2",
    "typescript": "~6.0.0",
    "vitest": "~4.1.10"
  }
}
