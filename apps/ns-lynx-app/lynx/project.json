{
  "name": "ns-lynx-app-lynx",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ns-lynx-app/lynx/src",
  "targets": {
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/lynx.config.ts",
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "command": "pnpm typecheck",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/src/tsconfig.json"
      ]
    }
  }
}
