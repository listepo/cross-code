{
  "name": "ns-wry-app",
  "main": "app/app.ts",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "NativeScript test app for @cross-code/ns-wry \u2014 displays a WebView with google.com on the first page.",
  "scripts": {
    "run.ios": "nx run ns-wry-app:run.ios",
    "run.android": "nx run ns-wry-app:run.android",
    "debug.ios": "nx run ns-wry-app:debug.ios",
    "debug.android": "nx run ns-wry-app:debug.android",
    "build.ios": "nx run ns-wry-app:build.ios",
    "build.android": "nx run ns-wry-app:build.android",
    "clean.ios": "nx run ns-wry-app:clean -- --platform=ios",
    "clean.android": "nx run ns-wry-app:clean -- --platform=android",
    "clean": "nx run ns-wry-app:clean",
    "build.plugin": "cd ../../ && pnpm exec nx run ns-wry:build"
  },
  "dependencies": {
    "@cross-code/ns-wry": "file:../../packages/ns-wry",
    "@nativescript/core": "~9.0.0",
    "@nativescript/theme": "^3.1.0"
  },
  "devDependencies": {
    "@nativescript/android": "9.0.5",
    "@nativescript/ios": "9.0.3",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "~5.0.25",
    "postcss-loader": "8.2.1",
    "ts-loader": "9.6.2",
    "typescript": "~6.0.0"
  }
}