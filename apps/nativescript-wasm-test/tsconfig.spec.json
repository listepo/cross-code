{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    // TypeScript 6 no longer pulls in every @types package automatically, and
    // mocha's describe/it and chai's expect are globals here: karma serves both
    // to the device, where the runner evaluates them (see its
    // TestExecutionService.loadShim). Nothing imports them.
    "types": ["mocha", "karma-chai"]
  },
  "files": ["./references.d.ts", "app/test.ts"],
  "include": ["app/**/*.spec.ts", "app/**/*.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
